# Rayfin environment configuration — copy to `rayfin/.env` and fill in.
#
# `rayfin/.env` is gitignored. Values prefixed with RAYFIN_SECRET_ are pushed to
# the workload (encrypted) by `rayfin up secrets apply`; the part after the
# prefix becomes the secret name read via `ctx.getSecret(...)` in
# `rayfin/functions/src/function_app.ts`.

# Azure OpenAI — required by the `generateOntology` function.
RAYFIN_SECRET_AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
RAYFIN_SECRET_AZURE_OPENAI_API_KEY=YOUR-API-KEY
RAYFIN_SECRET_AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
